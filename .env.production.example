# Production Environment Variables
# Copy this to .env on your EC2 instance and fill in the values

# Server
NODE_ENV=production
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/inchagram
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inchagram

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AWS S3 (for photo uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=inchagram-photos
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Inchagram <no-reply@inchagram.com>

# Frontend URL
FRONTEND_URL=https://inchagram.com

# CORS
CORS_ORIGIN=https://inchagram.com,https://www.inchagram.com
