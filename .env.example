# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/inchagram
MONGODB_TEST_URI=mongodb://localhost:27017/inchagram_test

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
BCRYPT_ROUNDS=10

# JWT Configuration
# IMPORTANT: Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here-min-32-chars-recommended
JWT_EXPIRES_IN=7d

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=inchagram-photos-dev
